# Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/astraiv_db

# Admin Authentication
BETTER_AUTH_SECRET=your_auth_secret_key_here
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
ADMIN_EMAIL=astraivtechnologies@gmail.com

# JWT Authentication (64-byte key)
JWT_SECRET=47a9e48c7732e9d6b94d7470263c34ab7c71d27c2815a4e2c5623a1c416dbb524bbe844b4cd056d1b1792b6265a9539d4546d196f5a629ab43ec00eea11a79db8
JWT_ACCESS_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN=30d

# Webhook Secrets
GOOGLE_SHEET_WEBHOOK_SECRET=your_sheet_webhook_secret
GOOGLE_FORM_WEBHOOK_SECRET=your_form_webhook_secret

# Supabase Storage (Optional)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Analytics 4 (Data API)
# GA_PROPERTY_ID: Numeric ID found in Google Analytics Admin > Property Settings (e.g. 483920194)
GA_PROPERTY_ID=123456789
# Path to your downloaded service account JSON file on the server (relative to admin or absolute)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Optional alternative to file path (useful on platforms like Vercel/Render):
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
