# ==============================================================================
# Astraiv Technologies — Admin Dashboard Docker Environment Template
# ==============================================================================
# Copy this file to .env.docker (or inject via docker compose / Docker run).
# NEVER commit production passwords, tokens, or secret keys to version control.
# In production, inject these via secure secrets management or Linux environment.
# ==============================================================================

# --- Application Runtime Networking ---
PORT=3001
HOSTNAME=0.0.0.0
# Browser-facing origin (local testing: http://localhost:3001, production: https://superuser.admin.astraivtechnologies.com)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Client application origin for preview links and cross-app navigation
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# --- General System ---
NEXT_TELEMETRY_DISABLED=1

# --- Supabase PostgreSQL Database (Prisma ORM with pg adapter) ---
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL=postgresql://postgres.your-supabase-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# --- Admin Authentication & Session Cryptography ---
ADMIN_EMAIL=astraivtechnologies@gmail.com
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3001
JWT_SECRET=your_jwt_signing_secret_minimum_64_characters
JWT_ACCESS_EXPIRES_IN=60d
JWT_REFRESH_EXPIRES_IN=30d

# --- Cross-Application Cache Invalidation ---
# Must exactly match REVALIDATE_SECRET in the Client website
REVALIDATE_SECRET=your_shared_revalidate_secret_minimum_32_characters

# --- Form Webhooks ---
GOOGLE_FORM_WEBHOOK_SECRET=your_form_sync_secret_here

# --- Supabase Public Media CMS & Storage ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Google Analytics 4 (Data API) ---
GA_PROPERTY_ID=555075963
# Base64-encoded Google Cloud service account JSON or raw JSON string:
GOOGLE_SERVICE_ACCOUNT_KEY=BASE64_ENCODED_GOOGLE_SERVICE_ACCOUNT_JSON

# --- Cloudflare R2 Private Candidate Resume Retrieval ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_RESUME_BUCKET_NAME=astraiv-candidate-resumes
